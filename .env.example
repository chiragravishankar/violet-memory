TELEGRAM_BOT_TOKEN=123456:your-bot-token-from-BotFather
LLM_API_KEY=sk-your-openai-key
# cognee 1.6.1 format: "<provider>/<model>". The "openai/" prefix tells cognee
# the provider. Plain "gpt-4o-mini" also works (provider defaults to openai).
LLM_MODEL=openai/gpt-4o-mini
# Optional: model for deadline extraction from files and messages (defaults to LLM_MODEL).
# gpt-4.1-mini found every deadline in a 12-page Brightspace calendar; gpt-4o-mini missed a few.
# EXTRACT_MODEL=gpt-4.1-mini
# Your Telegram user id: the owner (owner commands, Google features). Personal calendar feeds are NOT
# set here: each user connects theirs in chat (/connect), stored encrypted in the database.
VIOLET_OWNER_ID=123456789
# Encrypts user secrets (calendar links) at rest. Generate once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VIOLET_SECRET_KEY=
# Optional: model for Violet's voice (every reply). Defaults to LLM_MODEL.
# VOICE_MODEL=gpt-4o-mini
# Luma iCal feeds, comma-separated (discover feeds or community calendars)
# LUMA_ICS_URLS=https://api.luma.com/ics/get?entity=discover&id=...
# Optional: model for the conversational agent (tool calling). Defaults to gpt-5.4.
# CHAT_MODEL=gpt-5.4

# Memory backend: cloud (Cognee Cloud, default) or local (Cognee databases under data/)
COGNEE_MODE=cloud
# From platform.cognee.ai: your tenant URL and API key. Never commit or log the key.
COGNEE_SERVICE_URL=https://tenant-xxxx.aws.cognee.ai
COGNEE_API_KEY=
