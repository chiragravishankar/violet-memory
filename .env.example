TELEGRAM_BOT_TOKEN=123456:your-bot-token-from-BotFather
LLM_API_KEY=sk-your-openai-key
# cognee 1.6.1 format: "<provider>/<model>". The "openai/" prefix tells cognee
# the provider. Plain "gpt-4o-mini" also works (provider defaults to openai).
LLM_MODEL=openai/gpt-4o-mini
# Optional: model for deadline extraction from files and messages (defaults to LLM_MODEL).
# gpt-4.1-mini found every deadline in a 12-page Brightspace calendar; gpt-4o-mini missed a few.
# EXTRACT_MODEL=gpt-4.1-mini
# Optional: private Google Calendar iCal address (Settings > your calendar > Secret address in iCal format)
# GOOGLE_ICS_URL=https://calendar.google.com/calendar/ical/.../basic.ics
# Telegram user id whose calendar this is
# GOOGLE_ICS_USER_ID=123456789
